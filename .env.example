# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DBNAME"

# Абсолютный путь к папке public на сервере (куда пишутся /uploads). Рекомендуется на проде: /var/www/citylegend/public
# UPLOADS_DIR="/var/www/citylegend/public"

# Автозапуск initDatabase() в ensureDatabase().
# В production лучше оставить "false" (или пусто), чтобы не выполнять тяжёлые DDL/seed на cold start.
# Структура БД поднимается через ensureDatabase() при старте приложения.
AUTO_DB_INIT="false"

# Site (укажите при деплое)
# Публичный URL сайта (на проде обязательно https://citylegend.art — иначе в политиках/OG может подставиться localhost)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_BRAND_NAME="Бижутерия"
NEXT_PUBLIC_CONTACT_EMAIL="info@example.com"
# Необязательно: отображаемый телефон и E.164 для schema.org (по умолчанию +7 (965) 231-60-18 / +79652316018)
# NEXT_PUBLIC_CONTACT_PHONE="+7 (965) 231-60-18"
# NEXT_PUBLIC_CONTACT_PHONE_E164="+79652316018"

# Аналитика (если пусто — скрипты не подключаются)
# Google Tag Manager — контейнер вида GTM-XXXXXXX (приоритет над GA4)
NEXT_PUBLIC_GTM_ID=""
# Google Analytics 4 — только если GTM не задан (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Яндекс.Метрика — числовой id счётчика
NEXT_PUBLIC_YANDEX_METRIKA_ID=""

# Юридические реквизиты для страниц политики / оферты (РФ)
NEXT_PUBLIC_LEGAL_ENTITY_NAME="ООО «Ромашка»"
NEXT_PUBLIC_LEGAL_INN="0000000000"
NEXT_PUBLIC_LEGAL_OGRN=""
NEXT_PUBLIC_LEGAL_ADDRESS="123000, Москва, ул. Примерная, 1"
# Те же реквизиты хранятся в таблице site_legal (см. initDatabase и npm run db:seed-legal). При наличии строки в БД она имеет приоритет над env.

# Личный кабинет: подпись JWT для httpOnly-cookie (минимум 32 символа)
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=""
# Логин, которому ensureAdminUsersSchema выдаёт роль super_admin
SUPERADMIN_EMAIL=""

# Email (SMTP) — для отправки кодов подтверждения и ссылок сброса пароля
# Gmail: используйте пароль приложения (Google Account → Security → App passwords)
# Почта: с российского VPS Gmail SMTP (465) заблокирован — используйте Resend (HTTPS) или SMTP-прокси.
# Resend (рекомендуется на проде): https://resend.com → API Keys + верификация домена citylegend.art
# Без RESEND_FROM с вашим доменом Resend шлёт только на email владельца аккаунта (sandbox).
RESEND_API_KEY=""
RESEND_FROM="City Legend <no-reply@your-domain.art>"

SMTP_USER="your-mailbox@gmail.com"
SMTP_PASS="app-password-here"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
# SMTP_HTTPS_PROXY=""  # если есть HTTP CONNECT-прокси (как для Telegram)
# SMTP_SECURE="true"   # true (port 465) по умолчанию; false для STARTTLS (port 587)
# SMTP_FROM_NAME="City Legend"  # имя отправителя (по умолчанию — бренд сайта)

# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=""
# Произвольная строка для верификации вебхука (придумайте сами)
TELEGRAM_WEBHOOK_SECRET=""
# Если api.telegram.org недоступен с сервера (РФ): CONNECT HTTPS-прокси для tg-polling и исходящих вызовов Next.js (Squid, 3proxy на VPS вне блокировки и т.п.)
# Пример: http://user:pass@proxy.example.com:3128 — или положите одну строку в deploy/telegram-https-proxy.secret (см. .example там)
# TELEGRAM_HTTPS_PROXY=""
# Обход блокировки api.telegram.org без платного прокси: свой Worker на Cloudflare → см. deploy/cf-telegram-relay/README.txt и npm run telegram-relay:deploy
# TELEGRAM_API_RELAY_URL="https://citylegend-telegram-api-relay.<your-subdomain>.workers.dev"
# TELEGRAM_API_RELAY_SECRET=""
# Username бота (без @), показывается на сайте как ссылка
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Уведомления об оплаченных заказах (используются TELEGRAM_BOT_TOKEN и MAX_BOT_TOKEN).
# Несколько чатов — через запятую (Telegram: свой user id, группа −100…; Max: chat_id из API).
ORDER_NOTIFY_TELEGRAM_CHAT_IDS=""
ORDER_NOTIFY_MAX_CHAT_IDS=""

# Уведомления о новых обращениях в поддержку (fallback — ORDER_NOTIFY_*).
CONCIERGE_NOTIFY_TELEGRAM_CHAT_IDS=""
CONCIERGE_NOTIFY_MAX_CHAT_IDS=""

# Cron для отложенных рассылок и триггерных сообщений ботов (deploy/bots-cron.js)
BOT_CRON_SECRET=""
# BOT_CRON_INTERVAL_MS=900000

# Max Bot (получить: business.max.ru → Чат-боты → Интеграция; в заголовке Authorization передаётся сам токен, без Bearer)
MAX_BOT_TOKEN=""
# Базовый URL API Max (с июля 2026 — platform-api2.max.ru; старый platform-api.max.ru отключают)
MAX_API_BASE_URL="https://platform-api2.max.ru"
# Корневые CA Минцифры для TLS к platform-api2 (на сервере: deploy/install-max-ca-cert.sh)
NODE_EXTRA_CA_CERTS=""
# Произвольная строка для верификации вебхука Max
MAX_WEBHOOK_SECRET=""
# Прямая ссылка на Max-бота (показывается на сайте, если задана)
NEXT_PUBLIC_MAX_BOT_LINK=""

# T‑Bank (Tinkoff) E‑Acquiring: https://developer.tbank.ru/eacq/intro
# Без TBANK_* оплата в dev остаётся «мгновенной» (без реального банка).
# Пара для серверного API Init — только из Т‑Бизнес → Оплата → интернет-эквайринг → нужный терминал (TerminalKey + пароль терминала).
# Пароль с экрана мастера «платёжный виджет» / тестовый …DEMO обычно другой и даёт «Неверный токен» на /v2/Init — это не баг кода.
# Быстрая проверка без своего терминала: TinkoffBankTest / TinkoffBankTest (публичная тестовая пара SDK).
# Боевой терминал — ключ без суффикса DEMO и пароль из того же раздела эквайринга. Меняются только TBANK_*.
# На сервере: /var/www/citylegend/.env; deploy.sh подставляет TBANK из локального .env или .env.local.
TBANK_TERMINAL_KEY=""
TBANK_PASSWORD=""
# Необязательно: переопределить базовый URL API (по умолчанию https://securepay.tinkoff.ru).
# Не задавайте rest-api-test.tinkoff.ru без необходимости — с части сетей там 403 (HTML), ломается Init.
TBANK_API_URL=""

# СДЭК — доставка по России (только Россия, фикс‑тариф)
# По умолчанию доставка СДЭК включена с фиксированной ценой 300 ₽ по всей РФ.
# Чтобы временно выключить доставку (например, для самовывоза), задайте CDEK_DELIVERY_DISABLED=1.
# Цена доставки — из калькулятора СДЭК (официальный тариф). Запасной фикс только без API: CDEK_FIXED_DELIVERY_RUB.
# Принудительно всегда фикс (не рекомендуется): CDEK_FIXED_DELIVERY_ONLY=1
# CDEK_DELIVERY_DISABLED=""
# CDEK_FIXED_DELIVERY_RUB="300"
# CDEK_FIXED_DELIVERY_ONLY=""
#
# Полное API СДЭК (опционально — нужно только для подбора ПВЗ на странице оплаты
# и для автоматического создания заказов в ЛК СДЭК после оплаты).
# Если переменные ниже не заданы — оплата на сайте всё равно работает: пользователь
# вводит адрес вручную, фикс‑тариф 300 ₽ добавляется к сумме заказа.
# Идентификатор и секрет из раздела интеграции (не пароль от входа в веб-ЛК).
CDEK_CLIENT_ID=""
CDEK_CLIENT_SECRET=""
# Город отправителя СДЭК. Можно задать любым из двух способов:
#   1) Числовым кодом из справочника СДЭК — CDEK_SENDER_CITY_CODE="414" (414 — Нижний Новгород, 603000)
#   2) Названием города — CDEK_SENDER_CITY="Нижний Новгород" (сервер сам подберёт код через CDEK API)
# Если оба значения пустые, отправка через ЛК СДЭК не создаётся (но 300 ₽ к заказу всё равно прибавляется).
CDEK_SENDER_CITY_CODE="414"
# CDEK_SENDER_CITY="Нижний Новгород"
# Контакты и адрес отправителя (если не задан CDEK_SHIPMENT_POINT):
CDEK_SENDER_NAME=""
CDEK_SENDER_PHONE=""
CDEK_SENDER_ADDRESS=""
# Код склада/ПВЗ отгрузки по договору с СДЭК (из личного кабинета):
# CDEK_SHIPMENT_POINT=""
# Тест: CDEK_USE_SANDBOX=1
# CDEK_API_BASE="https://api.edu.cdek.ru/v2"
# Вебхук статусов (URL для ЛК СДЭК: {SITE}/api/webhooks/cdek). Если задан — проверяйте заголовок X-Webhook-Secret или Authorization: Bearer
# CDEK_WEBHOOK_SECRET=""
