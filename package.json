{
  "name": "premsite",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 111",
    "Safari >= 16.4",
    "iOS >= 16.4",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "bash deploy/sync-next-static.sh",
    "start": "next start",
    "lint": "eslint",
    "seed:documents": "node scripts/seed.mjs",
    "db:sync-homepage-about": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/sync-homepage-about-db.ts",
    "db:seed-legal": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/seed-site-legal.ts",
    "telegram-relay:deploy": "cd deploy/cf-telegram-relay && npx wrangler@3 deploy",
    "telegram-relay:bootstrap": "bash deploy/bootstrap-telegram-relay.sh"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/nodemailer": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.2",
    "leaflet": "^1.9.4",
    "next": "16.0.10",
    "nodemailer": "^8.0.7",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.0",
    "resend": "^6.12.3",
    "telegraf": "^4.16.3",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.27",
    "eslint": "^9",
    "eslint-config-next": "16.0.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
